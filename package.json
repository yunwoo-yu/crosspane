{
  "name": "crosspane-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:publishable": "node scripts/check-publishable.mjs",
    "coverage": "pnpm -r coverage",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo packages/*/dist/*.tsbuildinfo",
    "dev": "pnpm -r --parallel dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "husky",
    "release": "pnpm build && pnpm exec changeset publish",
    "smoke": "node scripts/smoke.mjs",
    "hub": "node packages/cli/dist/index.js",
    "hub:lan": "node packages/cli/dist/index.js --host 0.0.0.0",
    "demo": "node examples/demo/serve.mjs",
    "mcp": "node packages/cli/dist/index.js mcp",
    "try": "node scripts/try.mjs",
    "try:lan": "node scripts/try.mjs --lan",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "ws": "^8.18.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
